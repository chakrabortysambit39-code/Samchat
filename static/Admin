<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Samchat Admin — Payments</title>
<style>
  body { background:#111; color:#eee; font-family: system-ui, sans-serif; padding: 24px; }
  h1 { font-size: 20px; margin-bottom: 16px; }
  .hidden { display:none; }
  input, button { padding: 8px 10px; border-radius: 6px; border: 1px solid #444; background:#1c1c1c; color:#eee; }
  button { cursor:pointer; background:#2d6cdf; border-color:#2d6cdf; }
  button.reject { background:#a33; border-color:#a33; }
  button:hover { opacity:0.9; }
  table { width:100%; border-collapse: collapse; margin-top: 16px; }
  th, td { text-align:left; padding: 8px 10px; border-bottom: 1px solid #333; font-size: 14px; }
  th { color:#999; font-weight:500; }
  .empty { color:#888; margin-top: 20px; }
  #keyGate { max-width: 320px; margin-top: 60px; }
  #keyGate input { width: 100%; margin-bottom: 10px; }
</style>
</head>
<body>

  <div id="keyGate">
    <h1>Admin login</h1>
    <input id="adminKey" type="password" placeholder="Admin key">
    <button onclick="setKey()">Enter</button>
    <p id="keyError" style="color:#f66; display:none;">Invalid key or connection failed.</p>
  </div>

  <div id="panel" class="hidden">
    <h1>Pending Payments (₹200 Premium)</h1>
    <div id="ordersWrap">
      <p class="empty">Loading...</p>
    </div>
  </div>

<script>
let ADMIN_KEY = null;

function setKey() {
  const key = document.getElementById('adminKey').value.trim();
  if (!key) return;
  ADMIN_KEY = key;
  loadOrders();
}

async function loadOrders() {
  try {
    const res = await fetch('/api/admin/payments/pending', {
      headers: { 'X-Admin-Key': ADMIN_KEY }
    });
    if (res.status === 401 || res.status === 403) {
      document.getElementById('keyError').style.display = 'block';
      return;
    }
    const data = await res.json();
    document.getElementById('keyGate').classList.add('hidden');
    document.getElementById('panel').classList.remove('hidden');
    renderOrders(data.orders || []);
  } catch (e) {
    document.getElementById('keyError').style.display = 'block';
  }
}

function renderOrders(orders) {
  const wrap = document.getElementById('ordersWrap');
  if (!orders.length) {
    wrap.innerHTML = '<p class="empty">No pending payments.</p>';
    return;
  }

  const rows = orders.map(o => `
    <tr>
      <td>${o.order_id}</td>
      <td>${o.user_id}</td>
      <td>₹${o.amount}</td>
      <td>${o.upi_txn_ref || '<span style="color:#888">not submitted</span>'}</td>
      <td>${o.status}</td>
      <td>
        <button onclick="approve('${o.order_id}')">Approve</button>
        <button class="reject" onclick="reject('${o.order_id}')">Reject</button>
      </td>
    </tr>
  `).join('');

  wrap.innerHTML = `
    <table>
      <thead>
        <tr><th>Order ID</th><th>User</th><th>Amount</th><th>UPI Txn Ref</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>${rows}</tbody>
    </table>
  `;
}

async function approve(orderId) {
  await fetch('/api/admin/payments/approve', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Admin-Key': ADMIN_KEY },
    body: JSON.stringify({ order_id: orderId })
  });
  loadOrders();
}

async function reject(orderId) {
  const reason = prompt('Reason for rejection (optional):') || '';
  await fetch('/api/admin/payments/reject', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Admin-Key': ADMIN_KEY },
    body: JSON.stringify({ order_id: orderId, reason })
  });
  loadOrders();
}
</script>
</body>
</html>
